# Kopyalayın: cp .env.example .env.local
# Anahtar yoksa uygulama otomatik DEMO modunda çalışır (scraping yok).
# Değerleri buraya YAZMAYIN — sadece .env.local dosyasına koyun.

# --- Amadeus Self-Service (https://developers.amadeus.com/) ---
# Ücretsiz test uygulaması oluştur → API Key / API Secret
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test (varsayılan, sandbox) | production
AMADEUS_ENV=test

# --- Kiwi Tequila (https://tequila.kiwi.com/) ---
KIWI_API_KEY=

# --- Skyscanner via RapidAPI ---
# Host, abone olduğunuz provider’a göre değişir
SKYSCANNER_RAPIDAPI_KEY=
SKYSCANNER_RAPIDAPI_HOST=sky-scanner3.p.rapidapi.com
# İsteğe bağlı path override (örn. /flights/search-roundtrip)
SKYSCANNER_RAPIDAPI_PATH=

# force = her zaman demo; boş = anahtar yoksa otomatik demo
DEMO_MODE=

NEXT_PUBLIC_DEFAULT_ORIGIN=IST
